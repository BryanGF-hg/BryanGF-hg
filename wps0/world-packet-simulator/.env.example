# Copia este fichero como .env y rellena tokens DISTINTOS para cada rol.
# Genera cada uno con:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
WPS_MASTER_TOKEN=
WPS_SLAVE_TOKEN=
WPS_MONITOR_TOKEN=

# URL del broker para master.py / slave.py (wss:// si el servidor usa TLS)
WPS_SERVER=ws://127.0.0.1:8765

# --- Solo servidor ---
# WPS_HOST=0.0.0.0
# WPS_PORT=8765
# WPS_MONITOR_PORT=8766
# WPS_DB=wps.sqlite3
# WPS_TIME_SCALE=22          # 1 ms simulado = 22 ms reales en pantalla

# --- TLS (fuera de red local) ---
# WPS_TLS_CERT=certs/server.crt
# WPS_TLS_KEY=certs/server.key
# --- TLS en los clientes con certificado propio ---
# WPS_TLS_CA=certs/server.crt

# --- Pulso de visitas de GitHub (solo en el .env del SERVIDOR) ---
# Token fine-grained con permiso de repositorio "Administration: Read-only"
# WPS_GITHUB_TOKEN=github_pat_...
# WPS_GITHUB_HOME=VALENCIA
# WPS_GITHUB_REPOS=usuario/repo1,usuario/repo2    # vacío = todos tus repos
# WPS_GITHUB_INTERVAL=300
